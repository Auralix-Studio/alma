// Colecciones y tipos en Alma: valor (estructura) vs referencia (modelo).
// Ejecutar con:  alma ejecutar ejemplos/tipos.alma
importar sistema

estructura Punto
    x: entero
    y: entero
fin

modelo Contador
    total: entero
fin

funcion principal()
    // — Listas y bucle para —
    numeros = [1, 2, 3, 4, 5]
    suma = 0
    para n en numeros
        suma = suma + n
    fin
    imprimir("Suma de la lista:")
    imprimir(suma)

    // — estructura = VALOR (se copia) —
    a = Punto(1, 1)
    b = a
    b.x = 99
    imprimir("Punto a (valor, intacto):")
    imprimir(a)
    imprimir("Punto b (copia modificada):")
    imprimir(b)

    // — modelo = REFERENCIA (se comparte) —
    c1 = Contador(0)
    c2 = c1
    c2.total = 10
    imprimir("Contador c1 (referencia compartida):")
    imprimir(c1.total)
fin
