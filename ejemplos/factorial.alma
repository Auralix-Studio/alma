// Factoriales en Alma — ejecutar con:  alma ejecutar ejemplos/factorial.alma
importar sistema

funcion factorial(n: entero) -> entero
    si n <= 1
        retornar 1
    sino
        retornar n * factorial(n - 1)
    fin
fin

funcion principal()
    imprimir("Factoriales del 1 al 6:")
    i = 1
    mientras i <= 6
        imprimir(factorial(i))
        i = i + 1
    fin
fin
