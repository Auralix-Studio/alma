// Modelo con métodos — como el Servidor de la especificación de Alma.
// Ejecutar con:  alma ejecutar ejemplos/basicos/servidor.alma
importar sistema

modelo Servidor
    host: texto
    puerto: entero

    funcion iniciar(h: texto, p: entero)
        host = h
        puerto = p
    fin

    funcion descripcion() -> texto
        retornar host + ":" + texto(puerto)
    fin
fin

funcion principal()
    s = Servidor("", 0)
    s.iniciar("localhost", 8080)
    imprimir("Servidor configurado en:")
    imprimir(s.descripcion())
fin
