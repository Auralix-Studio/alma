          ".alma"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alma",
        "scopeName": "source.alma",
        "path": "./syntaxes/alma.tmLanguage.json"
      }
    ]
  }
