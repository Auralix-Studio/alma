        \\i = 0
        \\mientras i < 3
        \\    imprimir(i)
        \\    i = i + 1
        \\fin
    ;
    try esperarSalida(src, "0\n1\n2\n");
}

test "función recursiva y principal()" {
    const src =
        \\funcion fact(n: entero) -> entero
        \\    si n <= 1
        \\        retornar 1
        \\    sino
        \\        retornar n * fact(n - 1)
        \\    fin
        \\fin
        \\funcion principal()
        \\    imprimir(fact(5))
        \\fin
    ;
    try esperarSalida(src, "120\n");
}

