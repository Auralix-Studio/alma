test "el error se propaga por las llamadas hasta el capturar" {
    const src =
        \\funcion peligrosa()
        \\    lanzar error("boom")
        \\fin
        \\funcion principal()
        \\    intentar
        \\        peligrosa()
        \\    capturar (e)
        \\        imprimir("atrapado: " + e.mensaje)
        \\    fin
        \\fin
    ;
    try esperarSalida(src, "atrapado: boom\n");
}

