importar red
importar json

fijo BASE = "https://tikwm.com"

funcion cabeceras() -> diccionario
    retornar {
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        "Cookie": "current_language=en",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/116.0.0.0 Safari/537.36"
    }
fin

funcion descargar(url: texto) -> diccionario
    si url == ""
        retornar {"estado": falso, "error": "Se requiere una URL para descargar."}
    fin
    intentar
        respuesta = red.publicar(BASE + "/api/", "url=" + red.codificar_url(url) + "&hd=1", cabeceras())
        cuerpo = json.analizar(respuesta["cuerpo"])
        datos = cuerpo["data"]

        si datos["duration"] == 0
            media = {
                "type": "image",
                "images": datos["images"],
                "image_count": longitud(datos["images"])
            }
        sino
            media = {
                "type": "video",
                "duration": datos["duration"],
                "nowatermark": {
                    "size": datos["size"],
                    "play": datos["play"],
                    "hd": { "size": datos["hd_size"], "play": datos["hdplay"] }
                },
                "watermark": { "size": datos["wm_size"], "play": datos["wmplay"] }
            }
        fin

        retornar {
            "estado": verdadero,
            "data": {
                "id": datos["id"],
                "title": datos["title"],
                "cover": datos["cover"],
                "media": media,
                "creation": datos["create_time"],
                "views_count": datos["play_count"],
                "like_count": datos["digg_count"],
                "comment_count": datos["comment_count"],
                "share_count": datos["share_count"],
                "favorite_count": datos["collect_count"],
                "author": datos["author"],
                "music": datos["music_info"]
            }
        }
    capturar (e)
        retornar {"estado": falso, "error": e.mensaje}
    fin
fin

funcion buscar(consulta: texto) -> diccionario
    si consulta == ""
        retornar {"estado": falso, "error": "Se requiere una consulta para buscar."}
    fin
    intentar
        cuerpo_post = "keywords=" + red.codificar_url(consulta) + "&count=20&cursor=0&hd=1"
        respuesta = red.publicar(BASE + "/api/feed/search/", cuerpo_post, cabeceras())
        videos = json.analizar(respuesta["cuerpo"])["data"]["videos"]
        si longitud(videos) == 0
            retornar {"estado": falso, "error": "No se encontraron resultados."}
        fin
        resultados = []
        para item en videos
            agregar(resultados, {
                "id": item["video_id"],
                "title": item["title"],
                "cover": item["cover"],
                "media": {
                    "type": "video",
                    "duration": item["duration"],
                    "nowatermark": item["play"],
                    "watermark": item["wmplay"]
                },
                "creation": item["create_time"],
                "views_count": item["play_count"],
                "like_count": item["digg_count"],
                "comment_count": item["comment_count"],
                "share_count": item["share_count"],
                "author": item["author"],
                "music": item["music_info"]
            })
        fin
        retornar {"estado": verdadero, "data": resultados}
    capturar (e)
        retornar {"estado": falso, "error": e.mensaje}
    fin
fin

funcion tendencias(region: texto) -> diccionario
    si region == ""
        retornar {"estado": falso, "error": "Se requiere una región para buscar."}
    fin
    intentar
        cuerpo_post = "region=" + red.codificar_url(region) + "&count=12&cursor=0&web=1&hd=1"
        respuesta = red.publicar(BASE + "/api/feed/list/", cuerpo_post, cabeceras())
        lista = json.analizar(respuesta["cuerpo"])["data"]
        resultados = []
        para item en lista
            autor = item["author"]
            agregar(resultados, {
                "id": item["video_id"],
                "title": item["title"],
                "cover": BASE + item["cover"],
                "media": {
                    "type": "video",
                    "duration": item["duration"],
                    "nowatermark": BASE + item["play"],
                    "watermark": BASE + item["wmplay"]
                },
                "creation": item["create_time"],
                "views_count": item["play_count"],
                "like_count": item["digg_count"],
                "comment_count": item["comment_count"],
                "share_count": item["share_count"],
                "author": {
                    "id": autor["id"],
                    "unique_id": autor["unique_id"],
                    "nickname": autor["nickname"],
                    "avatar": BASE + autor["avatar"]
                },
                "music": item["music_info"]
            })
        fin
        retornar {"estado": verdadero, "data": resultados}
    capturar (e)
        retornar {"estado": falso, "error": e.mensaje}
    fin
fin

funcion principal()
    resultado = descargar("https://www.tiktok.com/@comedy.funny813/video/7660079299625536798?is_from_webapp=1&sender_device=pc")
    si resultado["estado"]
        info = resultado["data"]
        imprimir("Titulo: " + texto(info["title"]))
        imprimir("Autor: " + texto(info["author"]["nickname"]))
        imprimir("Vistas: " + texto(info["views_count"]))
        imprimir("Me gusta: " + texto(info["like_count"]))
    sino
        imprimir("Error: " + texto(resultado["error"]))
    fin
fin
